{
  "name": "integration_openproject",
  "version": "3.2.0-dev",
  "description": "OpenProject Integration",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "NODE_ENV=production webpack --progress --config webpack.js",
    "dev": "NODE_ENV=development webpack --progress --config webpack.js",
    "watch": "NODE_ENV=development webpack --progress --watch --config webpack.js",
    "lint": "eslint \"{src,tests}/**/*.{js,vue}\"",
    "lint:fix": "eslint \"{src,tests}/**/*.{js,vue}\" --fix",
    "stylelint": "stylelint css src",
    "stylelint:fix": "stylelint css src --fix",
    "test:unit": "jest --silent",
    "test:unit:watch": "jest --watch --no-coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nextcloud/integration_openproject"
  },
  "keywords": [
    "openproject"
  ],
  "author": "Nextcloud GmbH and Nextcloud contributors",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/nextcloud/integration_openproject/issues"
  },
  "homepage": "https://github.com/nextcloud/integration_openproject",
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "engines": {
    "node": "^22.0.0",
    "npm": "^10.5.0"
  },
  "dependencies": {
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/dialogs": "^7.4.1",
    "@nextcloud/files": "^4.0.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/moment": "^1.3.5",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.9.0",
    "dompurify": "^3.4.12",
    "lodash": "^4.18.1",
    "vue": "^3.5.40",
    "vue-custom-element": "^3.3.0",
    "vue-material-design-icons": "^5.3.1"
  },
  "devDependencies": {
    "@nextcloud/babel-config": "^1.3.0",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/webpack-vue-config": "^7.0.2",
    "eslint-webpack-plugin": "^6.0.0",
    "flush-promises": "^1.0.2",
    "stylelint-webpack-plugin": "^5.1.0",
    "vue-loader": "^17.4.2"
  }
}
